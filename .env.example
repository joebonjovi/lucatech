# Copy this file to `.env.local` for local development, and set the same
# variables in your hosting provider's dashboard for production.
# Do NOT commit `.env.local` — it is gitignored.

# --- Site URL (used for canonical URLs, sitemap, SEO, JSON-LD) ---
# Use your real production domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.lucatechnologies.com

# --- Contact form email delivery (Resend) ---
# 1. Create a free account at https://resend.com
# 2. Add & verify your sending domain (or use onboarding@resend.dev for testing)
# 3. Create an API key and paste it below.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered. Defaults to siteConfig.email.
CONTACT_TO_EMAIL=jluca@jgltechnologies.com

# The "from" address. MUST be on a domain you verified in Resend.
# For quick testing you can use: onboarding@resend.dev
CONTACT_FROM_EMAIL=website@lucatechnologies.com
